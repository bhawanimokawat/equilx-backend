  NOTIFICATIONS
  CRM_LEADS
  ACCOUNT_DELETION
  INSTITUTE_DELETION
}

enum RetentionJobStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum RetentionHoldScope {
  DATA_CATEGORY
  USER
  INSTITUTE
  RECORD
}

model DataDeletionRequest {
  id                String                @id @default(uuid()) @db.Uuid
  targetType        DeletionTargetType
  targetId          String                @db.Uuid
  requestedByUserId String?               @db.Uuid
  status            DeletionRequestStatus @default(REQUESTED)

  reasonCode    String?
  requestedAt   DateTime  @default(now())
  verifiedAt    DateTime?
  approvedAt    DateTime?
  scheduledFor  DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  failureCode   String?
  resultSummary Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetType, targetId, createdAt])
  @@index([status, scheduledFor])
  @@index([requestedByUserId, createdAt])
}

model RetentionJobRun {
  id      String             @id @default(uuid()) @db.Uuid
  jobType RetentionJobType
  status  RetentionJobStatus @default(RUNNING)

  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  recordsScanned Int       @default(0)
  recordsDeleted Int       @default(0)
  recordsSkipped Int       @default(0)
  errorCount     Int       @default(0)
  summary        Json?
  failureCode    String?

  createdAt DateTime @default(now())

  @@index([jobType, startedAt])
  @@index([status, startedAt])
}

model RetentionHold {
  id           String             @id @default(uuid()) @db.Uuid
  scope        RetentionHoldScope
  dataCategory String?
  targetId     String?            @db.Uuid

  reasonCode       String
  placedByUserId   String    @db.Uuid
  placedAt         DateTime  @default(now())
  expiresAt        DateTime?
  releasedByUserId String?   @db.Uuid
  releasedAt       DateTime?
  isActive         Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, targetId, isActive])
  @@index([dataCategory, isActive])
  @@index([isActive, expiresAt])
  @@index([placedByUserId, placedAt])
}
