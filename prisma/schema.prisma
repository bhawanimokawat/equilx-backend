generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum MembershipRole {
  INSTITUTE_STUDENT
  TRAINER
  INSTITUTE_ADMIN
}

enum MembershipStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED_PENDING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum TwoFactorPurpose {
  LOGIN
}

enum InstituteStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  email                    String                    @unique
  passwordHash             String?
  platformRole             PlatformRole              @default(USER)
  emailVerifiedAt          DateTime?
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  subscriptions            Subscription[]
  usageCounters            UsageCounter[]
  profile                  UserProfile?
  authIdentities           AuthIdentity[]
  refreshTokens            RefreshToken[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  twoFactorChallenges      TwoFactorChallenge[]
  writingSubmissions       WritingSubmission[]
  writingEvaluationsGiven  WritingEvaluation[]       @relation("WritingEvaluator")
  speakingSubmissions      SpeakingSubmission[]
  speakingEvaluationsGiven SpeakingEvaluation[]      @relation("SpeakingEvaluator")
  trainerSpeakingSessions  SpeakingSession[]         @relation("SpeakingTrainer")
  studentSpeakingSessions  SpeakingSession[]         @relation("SpeakingStudent")
  aiJobs                   AIJob[]
  aiUsageLogs              AIUsageLog[]
  conversations            ConversationParticipant[]
  messagesSent             Message[]
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  leadsCreated             Lead[]                    @relation("LeadCreator")
  ownedLeads               Lead[]                    @relation("LeadOwner")
  convertedLeads           Lead[]                    @relation("LeadConvertedUser")
  leadActivities           LeadActivity[]            @relation("LeadActivityActor")
  leadAssignmentsReceived  LeadAssignment[]          @relation("LeadAssignmentAssignee")
  leadAssignmentsMade      LeadAssignment[]          @relation("LeadAssignmentAssigner")
  leadStatusChanges        LeadStatusHistory[]       @relation("LeadStatusActor")
  leadConsentsRecorded     LeadConsent[]             @relation("LeadConsentRecorder")

  assignmentsCreated  Assignment[]              @relation("AssignmentCreator")
  assignmentTargets   AssignmentTarget[]        @relation("AssignmentTargetUser")
  reportSnapshotsMade InstituteReportSnapshot[] @relation("ReportSnapshotCreator")

  attempts        Attempt[]
  mockScores      MockScore[]
  practiceResults PracticeResult[]
  auditLogs       AuditLog[]       @relation("AuditActor")
  securityEvents  SecurityEvent[]  @relation("SecurityEventUser")

  memberships         InstituteMembership[]
  createdInstitutes   Institute[]            @relation("InstituteCreator")
  sentInvitations     MembershipInvitation[] @relation("InvitationSender")
  receivedInvitations MembershipInvitation[] @relation("InvitationInvitee")
  reviewedInvitations MembershipInvitation[] @relation("InvitationReviewer")

  createdBatches   Batch[]       @relation("BatchCreator")
  batchMemberships BatchMember[]

  trainerAssignments    TrainerStudent[] @relation("TrainerAssignmentTrainer")
  studentAssignments    TrainerStudent[] @relation("TrainerAssignmentStudent")
  assignmentsMade       TrainerStudent[] @relation("TrainerAssignmentCreator")
  leadFollowUpsAssigned LeadFollowUp[]   @relation("LeadFollowUpAssignee")
  leadFollowUpsCreated  LeadFollowUp[]   @relation("LeadFollowUpCreator")

  @@index([isActive, createdAt])
}

model UserProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  name      String?  @map("displayName")
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerSubject String
  createdAt       DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId, revokedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model TwoFactorChallenge {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  purpose    TwoFactorPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int              @default(0)
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model Institute {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  slug        String          @unique
  status      InstituteStatus @default(ACTIVE)
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy             User                      @relation("InstituteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships           InstituteMembership[]
  invitations           MembershipInvitation[]
  batches               Batch[]
  assignments           TrainerStudent[]
  subscriptions         Subscription[]
  speakingSessions      SpeakingSession[]
  courseworkAssignments Assignment[]
  reportSnapshots       InstituteReportSnapshot[]
  conversations         Conversation[]
  leads                 Lead[]
  leadSources           LeadSource[]
  auditLogs             AuditLog[]
  securityEvents        SecurityEvent[]

  @@index([status, createdAt])
}

model InstituteMembership {
  id          String           @id @default(uuid()) @db.Uuid
  instituteId String           @db.Uuid
  userId      String           @db.Uuid
  role        MembershipRole
  status      MembershipStatus @default(PENDING_APPROVAL)
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([instituteId, userId])
  @@index([userId, status])
  @@index([instituteId, role, status])
}

model MembershipInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  instituteId     String           @db.Uuid
  invitedByUserId String           @db.Uuid
  invitedUserId   String?          @db.Uuid
  inviteeEmail    String
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  reviewedById    String?          @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Restrict)
  invitedBy   User      @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  invitedUser User?     @relation("InvitationInvitee", fields: [invitedUserId], references: [id], onDelete: Restrict)
  reviewedBy  User?     @relation("InvitationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([instituteId, status, createdAt])
  @@index([inviteeEmail, status])
  @@index([invitedUserId, status])
}

model Batch {
  id          String   @id @default(uuid()) @db.Uuid
  instituteId String   @db.Uuid
  name        String
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute         Institute               @relation(fields: [instituteId], references: [id], onDelete: Restrict)
  createdBy         User                    @relation("BatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members           BatchMember[]
  assignmentTargets AssignmentBatchTarget[]

  @@unique([instituteId, name])
  @@index([instituteId, createdAt])
}

model BatchMember {
  id      String   @id @default(uuid()) @db.Uuid
  batchId String   @db.Uuid
  userId  String   @db.Uuid
  addedAt DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([batchId, userId])
  @@index([userId])
}

model TrainerStudent {
  id               String           @id @default(uuid()) @db.Uuid
  instituteId      String           @db.Uuid
  trainerUserId    String           @db.Uuid
  studentUserId    String           @db.Uuid
  assignedByUserId String           @db.Uuid
  status           MembershipStatus @default(ACTIVE)
  assignedAt       DateTime         @default(now())
  revokedAt        DateTime?

  institute  Institute @relation(fields: [instituteId], references: [id], onDelete: Restrict)
  trainer    User      @relation("TrainerAssignmentTrainer", fields: [trainerUserId], references: [id], onDelete: Restrict)
  student    User      @relation("TrainerAssignmentStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  assignedBy User      @relation("TrainerAssignmentCreator", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@unique([instituteId, trainerUserId, studentUserId])
  @@index([instituteId, trainerUserId, status])
  @@index([instituteId, studentUserId, status])
}

enum PlanCode {
  FREE
  STUDENT_PRO
  INSTITUTE_6_MONTH
  INSTITUTE_12_MONTH
}

enum PlanOwnerType {
  INDIVIDUAL
  INSTITUTE
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
}

enum InvoiceStatus {
  ISSUED
  VOID
}

enum SubscriptionChangeType {
  ACTIVATED
  RENEWED
  UPGRADED
  DOWNGRADED
  CANCELLED
  EXPIRED
  ADMIN_ADJUSTMENT
}

enum UsageType {
  FULL_MOCK
  PRACTICE
}

model Plan {
  id          String        @id @default(uuid()) @db.Uuid
  code        PlanCode      @unique
  name        String
  ownerType   PlanOwnerType
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  versions      PlanVersion[]
  subscriptions Subscription[]

  @@index([ownerType, isActive])
}

model PlanVersion {
  id             String   @id @default(uuid()) @db.Uuid
  planId         String   @db.Uuid
  version        Int
  priceInclGst   Decimal  @db.Decimal(12, 2)
  currency       String   @default("INR") @db.VarChar(3)
  gstRate        Decimal  @default(18.00) @db.Decimal(5, 2)
  durationMonths Int?
  maxSeats       Int?
  fullMockQuota  Int      @default(0)
  practiceQuota  Int      @default(0)
  isLifetime     Boolean  @default(false)
  effectiveFrom  DateTime @default(now())
  createdAt      DateTime @default(now())

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@unique([planId, version])
  @@index([planId, effectiveFrom])
}

model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  planId            String             @db.Uuid
  planVersionId     String             @db.Uuid
  userId            String?            @db.Uuid
  instituteId       String?            @db.Uuid
  status            SubscriptionStatus @default(PENDING_PAYMENT)
  priceInclGst      Decimal            @db.Decimal(12, 2)
  currency          String             @default("INR") @db.VarChar(3)
  gstRate           Decimal            @db.Decimal(5, 2)
  durationMonths    Int?
  maxSeatsPurchased Int?
  startsAt          DateTime?
  endsAt            DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  institute   Institute?  @relation(fields: [instituteId], references: [id], onDelete: Restrict)

  payments Payment[]
  invoices Invoice[]
  changes  SubscriptionChange[]

  @@index([userId, status, endsAt])
  @@index([instituteId, status, endsAt])
  @@index([planId, status])
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  subscriptionId    String          @db.Uuid
  provider          PaymentProvider @default(RAZORPAY)
  status            PaymentStatus   @default(CREATED)
  amountInclGst     Decimal         @db.Decimal(12, 2)
  currency          String          @default("INR") @db.VarChar(3)
  providerOrderId   String?         @unique
  providerPaymentId String?         @unique
  idempotencyKey    String?         @unique
  failureCode       String?
  failureMessage    String?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  subscription  Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  webhookEvents PaymentWebhookEvent[]
  invoices      Invoice[]
  refunds       PaymentRefund[]

  @@index([subscriptionId, status, createdAt])
}

model PaymentWebhookEvent {
  id                  String          @id @default(uuid()) @db.Uuid
  paymentId           String?         @db.Uuid
  provider            PaymentProvider @default(RAZORPAY)
  providerEventId     String          @unique
  eventType           String
  payloadHash         String?
  signatureVerifiedAt DateTime?
  processedAt         DateTime?
  processingError     String?
  createdAt           DateTime        @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([processedAt, createdAt])
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  subscriptionId String        @db.Uuid
  paymentId      String?       @db.Uuid
  invoiceNumber  String        @unique
  status         InvoiceStatus @default(ISSUED)
  currency       String        @default("INR") @db.VarChar(3)
  subtotal       Decimal       @db.Decimal(12, 2)
  gstRate        Decimal       @db.Decimal(5, 2)
  cgstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  igstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  buyerName      String
  buyerEmail     String
  buyerGstin     String?
  placeOfSupply  String?
  issuedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, issuedAt])
}

model SubscriptionChange {
  id              String                 @id @default(uuid()) @db.Uuid
  subscriptionId  String                 @db.Uuid
  changeType      SubscriptionChangeType
  previousStatus  SubscriptionStatus?
  newStatus       SubscriptionStatus?
  details         Json?
  changedByUserId String?                @db.Uuid
  createdAt       DateTime               @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, createdAt])
}

model PaymentRefund {
  id               String        @id @default(uuid()) @db.Uuid
  paymentId        String        @db.Uuid
  providerRefundId String?       @unique
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("INR") @db.VarChar(3)
  reason           String?
  status           PaymentStatus @default(PENDING)
  refundedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, status])
}

model UsageCounter {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  usageType UsageType
  usedCount Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, usageType])
  @@index([userId])
}

enum IELTSSection {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum TestCategory {
  ACADEMIC
  GENERAL_TRAINING
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  SHORT_ANSWER
  SENTENCE_COMPLETION
  SUMMARY_COMPLETION
  NOTE_COMPLETION
  FORM_COMPLETION
  TABLE_COMPLETION
  MATCHING
  MATCHING_HEADINGS
  MATCHING_INFORMATION
  MATCHING_FEATURES
  MAP_LABELING
  DIAGRAM_LABELING
  FLOW_CHART_COMPLETION
  GAP_FILL
  ESSAY
  LETTER
  REPORT
  SPEAKING_RESPONSE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  ABANDONED
  EXPIRED
}

model Book {
  id         String        @id @default(uuid()) @db.Uuid
  title      String
  bookNumber Int?
  publisher  String?
  category   TestCategory?
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tests Test[]

  @@unique([title, category])
  @@index([isActive, bookNumber])
}

model Test {
  id         String        @id @default(uuid()) @db.Uuid
  bookId     String        @db.Uuid
  title      String
  testNumber Int
  category   TestCategory
  status     ContentStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  book     Book          @relation(fields: [bookId], references: [id], onDelete: Restrict)
  versions TestVersion[]

  @@unique([bookId, testNumber, category])
  @@index([category, status])
}

model TestVersion {
  id              String        @id @default(uuid()) @db.Uuid
  testId          String        @db.Uuid
  version         Int
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  contentChecksum String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  test               Test                    @relation(fields: [testId], references: [id], onDelete: Restrict)
  modules            TestModule[]
  bandConversions    BandConversionVersion[]
  attempts           Attempt[]
  assignmentContents AssignmentContent[]

  @@unique([testId, version])
  @@index([testId, status])
}

model TestModule {
  id              String       @id @default(uuid()) @db.Uuid
  testVersionId   String       @db.Uuid
  section         IELTSSection
  position        Int
  durationSeconds Int
  instructions    Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  testVersion TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Restrict)
  parts       TestPart[]

  attempts Attempt[] @relation("AttemptModule")

  @@unique([testVersionId, section])
  @@unique([testVersionId, position])
  @@index([section])
}

model TestPart {
  id            String   @id @default(uuid()) @db.Uuid
  testModuleId  String   @db.Uuid
  title         String
  position      Int
  instructions  Json?
  audioAssetKey String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  testModule TestModule      @relation(fields: [testModuleId], references: [id], onDelete: Restrict)
  groups     QuestionGroup[]
  questions  Question[]
  attempts   Attempt[]       @relation("AttemptPart")

  @@unique([testModuleId, position])
  @@index([testModuleId])
}

model QuestionGroup {
  id           String   @id @default(uuid()) @db.Uuid
  testPartId   String   @db.Uuid
  title        String?
  instructions Json?
  passage      Json?
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  testPart  TestPart   @relation(fields: [testPartId], references: [id], onDelete: Restrict)
  questions Question[]

  @@unique([testPartId, position])
  @@index([testPartId])
}

model Question {
  id              String       @id @default(uuid()) @db.Uuid
  testPartId      String       @db.Uuid
  questionGroupId String?      @db.Uuid
  questionNumber  Int
  questionType    QuestionType
  content         Json
  marks           Decimal      @default(1) @db.Decimal(5, 2)
  position        Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  testPart      TestPart        @relation(fields: [testPartId], references: [id], onDelete: Restrict)
  questionGroup QuestionGroup?  @relation(fields: [questionGroupId], references: [id], onDelete: Restrict)
  answerKey     AnswerKey?
  answers       AttemptAnswer[]

  @@unique([testPartId, questionNumber])
  @@index([testPartId, position])
  @@index([questionGroupId])
}

model AnswerKey {
  id              String   @id @default(uuid()) @db.Uuid
  questionId      String   @unique @db.Uuid
  acceptedAnswers Json
  explanation     Json?
  markingRules    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
}

model BandConversionVersion {
  id              String       @id @default(uuid()) @db.Uuid
  testVersionId   String       @db.Uuid
  section         IELTSSection
  version         Int
  conversionTable Json
  createdAt       DateTime     @default(now())

  testVersion TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Restrict)

  @@unique([testVersionId, section, version])
  @@index([testVersionId, section])
}

model Attempt {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @db.Uuid
  testVersionId String @db.Uuid

  // Practice scope (both NULL for FULL_MOCK)
  moduleId String? @db.Uuid
  partId   String? @db.Uuid

  usageType   UsageType
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  deadlineAt  DateTime?
  submittedAt DateTime?
  lastSavedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  writingSubmissions  WritingSubmission[]
  speakingSubmissions SpeakingSubmission[]

  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  testVersion TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Restrict)

  module TestModule? @relation("AttemptModule", fields: [moduleId], references: [id], onDelete: Restrict)
  part   TestPart?   @relation("AttemptPart", fields: [partId], references: [id], onDelete: Restrict)

  answers               AttemptAnswer[]
  mockScore             MockScore?
  practiceResult        PracticeResult?
  assignmentCompletions AssignmentCompletion[]

  @@index([userId, status, createdAt])
  @@index([testVersionId, status])
  @@index([status, deadlineAt])
  @@index([moduleId])
  @@index([partId])
}

model AttemptAnswer {
  id           String    @id @default(uuid()) @db.Uuid
  attemptId    String    @db.Uuid
  questionId   String    @db.Uuid
  answer       Json?
  firstSavedAt DateTime?
  lastSavedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([attemptId, lastSavedAt])
}

model MockScore {
  id            String   @id @default(uuid()) @db.Uuid
  attemptId     String   @unique @db.Uuid
  userId        String   @db.Uuid
  listeningBand Decimal? @db.Decimal(3, 1)
  readingBand   Decimal? @db.Decimal(3, 1)
  writingBand   Decimal? @db.Decimal(3, 1)
  speakingBand  Decimal? @db.Decimal(3, 1)
  overallBand   Decimal? @db.Decimal(3, 1)
  scoreSnapshot Json
